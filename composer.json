{
  "name": "forumaker/steam-oauth",
  "description": "Adds a Steam OAuth provider for FoF OAuth",
  "type": "flarum-extension",
  "keywords": ["flarum", "flarum-extension", "steam", "steamid", "oauth", "openid"],
  "license": "MIT",
  "homepage": "https://github.com/forumaker/Steam-Oauth",
  "support": {
    "issues": "https://github.com/forumaker/Steam-Oauth/issues",
    "source": "https://github.com/forumaker/Steam-Oauth",
    "forum": "https://discuss.flarum.org/"
  },
  "authors": [
    {
      "name": "forumaker",
      "role": "Developer",
      "homepage": "https://github.com/forumaker"
    }
  ],
  "require": {
    "php": "^8.2",
    "flarum/core": "^2.0",
    "fof/oauth": "^2.0",
    "league/oauth2-client": "^2.8"
  },
  "autoload": {
    "psr-4": {
      "forumaker\\Steam\\": "src/"
    }
  },
  "extra": {
    "branch-alias": {
      "dev-2.x": "2.x-dev"
    },
    "flarum-extension": {
      "title": "Steam OAuth",
      "category": "authentication",
      "icon": {
        "name": "fa-brands fa-steam",
        "backgroundColor": "#171a21",
        "color": "#ffffff"
      }
    }
  },
  "config": {
    "sort-packages": true
  }
}
